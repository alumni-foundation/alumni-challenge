ENVIRONMENT=development
DEBUG=true

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in staging or production with this placeholder.
SECRET_KEY=change-me-dev-only-not-a-real-secret

DATABASE_URL=postgresql+asyncpg://alumni:alumni_dev_password@localhost:5432/alumni_challenge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

SENTRY_DSN=

# local = files on disk under STORAGE_LOCAL_PATH (development only; production refuses it).
# r2 = any S3-compatible store (Cloudflare R2 in production); then all four settings below are
# required. The bucket must be private. For the emulator in docker-compose use
#   STORAGE_ENDPOINT_URL=http://s3mock:9090  STORAGE_ACCESS_KEY=dev  STORAGE_SECRET_KEY=dev
#   STORAGE_BUCKET_NAME=alumni-dev
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/uploads

STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=
